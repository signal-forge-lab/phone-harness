{
  "name": "phone-harness-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx src/server.test.ts && tsx src/runtime-bridge.test.ts && tsx src/oauth.test.ts && tsx src/http-server.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:device": "tsx scripts/real-device-smoke.ts",
    "smoke:device:http": "tsx scripts/real-device-http-smoke.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
