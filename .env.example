# phone-harness environment example
#
# This file intentionally contains placeholders only. Copy the values you need
# into your local environment or a private .env file. Never commit real tokens,
# device identifiers, tunnel URLs that expose private infrastructure, signing
# material, or account credentials.

# Runtime transport: usb | wifi | auto
PHONE_HARNESS_TRANSPORT=auto

# Optional: select a specific device when more than one is available.
# PHONE_HARNESS_UDID=YOUR_DEVICE_UDID

# Optional Python executable used by the MCP wrapper.
# PHONE_HARNESS_PYTHON=C:\path\to\phone-harness\.venv\Scripts\python.exe

# Optional generic defaults consumed by tools/configure_phone_harness_mcp.ps1.
# PHONE_HARNESS_TUNNELD_PYTHON=C:\path\to\phone-harness\.venv-tunneld\Scripts\python.exe
# PHONE_HARNESS_TUNNEL_CLIENT_PATH=C:\path\to\tunnel-client.exe
# PHONE_HARNESS_TUNNEL_PROFILE_PATH=C:\path\to\phone-harness-mcp.yaml
PHONE_HARNESS_CONTROL_PLANE_API_KEY_ENV_NAME=CONTROL_PLANE_API_KEY

# MCP server settings. Loopback is safe for local-only use. Replace URLs only
# with endpoints you control. Non-loopback endpoints must use HTTPS.
PHONE_HARNESS_MCP_PUBLIC_BASE_URL=http://127.0.0.1:17677/
PHONE_HARNESS_MCP_PORT=17677
# PHONE_HARNESS_MCP_OAUTH_ISSUER_URL=https://auth.example.invalid/
# PHONE_HARNESS_MCP_OAUTH_RESOURCE_URL=https://mcp.example.invalid/mcp
# PHONE_HARNESS_MCP_STATE_DIR=C:\path\to\local\phone-harness-mcp-state
PHONE_HARNESS_MCP_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1

# Secret values must be supplied locally and must never be committed.
# PHONE_HARNESS_MCP_OWNER_TOKEN=replace-with-a-random-token-at-least-16-characters
# CONTROL_PLANE_API_KEY=replace-with-your-runtime-api-key
