{"e":"U","k":"order.priority.board-distance","v":{"rule":"rank orders by practical completion distance from current same-family board inventory, not requested level alone","example":[{"board_level":3,"order_level":5,"priority":"high"},{"board_level":5,"order_level":9,"priority":"low"}],"evidence":"USER_CONFIRMED","date":"2026-08-20"}}
{"e":"U","k":"producer.exploration","v":{"rule":"arbitrary production is acceptable when no directly useful producer is available; generated items are not wasted because they will eventually serve some order","learning":"when producer/output knowledge is incomplete, produce in bounded bursts, observe outputs, learn, and re-plan","date":"2026-08-20"}}
{"e":"U","k":"energy.spend-policy","v":{"rule":"normally continue autonomous Merge Boss play until energy is approximately 0 rather than stopping around 50","reason":"energy regenerates quickly, so leaving usable energy idle wastes regeneration opportunity","exceptions":["operator Pause","pending Human Teaching","device/bridge instability","board state prevents safe useful spending"],"date":"2026-08-21"}}
{"e":"U","k":"merge.compaction-policy","v":{"rule":"merge any safely confirmed merge-compatible items even when they are not requested by a current order","reason":"board space is a primary constraint and leaving mergeable duplicates consumes cells","future_low_level_orders":"rebuild from newly produced low-level items rather than preserving lower-level duplicates just in case","date":"2026-08-21"}}
{"e":"U","k":"orders.refresh-policy","v":{"rule":"if visible orders are dominated by very high-level or otherwise extremely distant requirements, use the green refresh button at the lower-left of the order card to replace that customer; repeat refresh when the replacement is still poor","human_gate":"when distance/refresh-count tradeoffs are ambiguous, ask the operator instead of inventing a universal cutoff","date":"2026-08-21"}}
{"e":"D","k":"producer.vertical-film-camera.8","v":{"display":"縦型フィルムカメラ","family":"撮影機器ファミリー","level":8,"max":8,"outputs":[["viewing-equipment",1],["romeo-juliet-props",1],["viewing-equipment",2],["romeo-juliet-props",2]],"outputs_semantic_complete":true,"evidence":"order_item_i+producer_i"}}
{"e":"U","k":"merge.bubble-duplicate","v":{"rule":"a merge can create an extra copy wrapped in a bubble","priority":"tap bubbled item before normal play","date":"2026-08-21"}}
{"e":"U","k":"merge.bubble-ad-flow","v":{"trigger":"tap bubbled item","flow":["reward/ad screen opens","wait for center-right countdown to reach zero","countdown changes to a check mark","tap check mark","return to Merge Boss"],"safety":"do not guess fixed coordinates; re-observe the current screen","date":"2026-08-21"}}
{"e":"U","k":"merge.bubble-time-limit","v":{"rule":"bubble items are time-limited and must be handled before ordinary board work","expiry":"if the ad is not watched in time, the bubble degrades into a round lightning icon and loses value","date":"2026-08-21"}}
{"e":"U","k":"merge.bubble-preemption","v":{"rule":"a visible bubble preempts the current low-risk subtask immediately, including order inspection, item-family learning, producer planning, and normal merge batching","reason":"the bubble loses value with time and degrades into a round lightning item","execution":"finish only the minimum safe UI dismissal needed to reach the board, then tap the bubble before resuming the interrupted subtask","source":"human_teaching","date":"2026-08-22"}}
{"e":"D","k":"merge.bubble-expiry-negative-evidence.20260822","v":{"observed":"a visible bubble expired into a round lightning item before its reward flow was completed","cause_context":"time was spent on order/family learning and observation while the bubble remained visible","lesson":"bubble handling must interrupt knowledge-gathering immediately; do not spend semantic/OCR or catalog-learning time first","priority":"hard preemption while bubble is visible","date":"2026-08-22"}}
{"e":"U","k":"performance.burst-length-vs-bubble-risk","v":{"status":"candidate","observation":"long merge bursts improve throughput but can delay discovery of newly-created time-limited bubbles","candidate":"use shorter bounded gameplay bursts with cheap visual urgent-item checks between bursts; increase burst length only when evidence shows bubble creation is impossible or cheaply detectable in-loop","evaluation":["actions_per_minute","bubble capture rate","observation overhead","recovery cost"],"do_not_promote_without_evidence":true,"date":"2026-08-22"}}
{"e":"U","k":"energy.round-lightning","v":{"rule":"when a round lightning icon is selected and then tapped, it is collected/converted and grants +1 Merge Boss energy","date":"2026-08-21"}}
{"e":"U","k":"energy.round-lightning-priority","v":{"rule":"round lightning icons have no further evolution/use other than collection, so collect them before ordinary merge/production work whenever visible","relationship_to_bubble":"normally handle the bubble first, so lightning-icon fallback should be rare","date":"2026-08-21"}}
{"e":"U","k":"energy.zero-menu","v":{"trigger":"when Merge Boss energy reaches 0, tap the plus icon beside the energy counter","title":"エネルギーを獲得","passive_regen":{"capacity":100,"observed_interval":"about 2 minutes per energy"},"paid_x50":{"cash":500,"diamonds":300},"daily_claim":{"observed_reward":25,"button":"獲得","effect":"immediate; menu remained open and energy became 26/100 because one passive point also regenerated","one_time_per_day":true},"task_examples":[{"reward":20,"action":"browse bargain items","button":"移動"},{"reward":15,"action":"US $1,000,000 prize task","button":"移動"},{"reward":600,"action":"tap Go and place an order on that page","button":"移動"}],"daily_task_refresh":"15:59","date":"2026-08-21"}}
{"e":"U","k":"energy.recovery-priority","v":{"rule":"while any recovery method remains, do not end the play task; when zero, prefer simple ad-watch recovery first","ad_flow":"same interaction model as bubble reward: start ad -> wait for countdown -> tap check mark -> return to Merge Boss","end_condition":"energy is 0 AND no usable recovery method remains","objective":"spend recoverable energy while completing as many customer orders as practical","date":"2026-08-21"}}
{"e":"U","k":"performance.merge-identification","v":{"rule":"known items should not require repeated info-panel focus; use stable cell positions, learned visuals, and known merge-successor levels to predict forward","escalation":"when confidence drops or board is jammed, temporarily switch to higher-resolution whole-board scanning and only inspect panels for shortlisted ambiguous pairs","invariant":"items do not move/disappear spontaneously; exploit temporal continuity between observations","date":"2026-08-21"}}
{"e":"U","k":"energy.zero-menu-scroll","v":{"rule":"the energy-recovery window is vertically scrollable; inspect below-the-fold entries before concluding that no recovery method remains","browse_task_flow":"for 'view/browse X' tasks, the repeated interaction is navigate -> wait the required duration -> perform the completion/return action","date":"2026-08-21"}}
{"e":"U","k":"special.green-cash-stack","v":{"rule":"green cash-stack icons are not ordinary customer-order items; their useful lifecycle is merge plus the item-specific collect/convert action","merge_priority":"high for board compaction","next_learning":"select one and read its in-game help before generalizing the terminal action semantics","date":"2026-08-21"}}
{"e":"D","k":"special.green-cash-stack.lv5","v":{"display":"紙幣の大きな束","level":5,"double_tap_reward":"32枚の紙幣","merge_result":{"display":"袋一杯の紙幣","level":6},"policy":"prefer safe same-level merges for board compaction; collect by double tap when choosing to cash out rather than preserve/merge","evidence":"live selected-item help","date":"2026-08-21"}}
{"e":"U","k":"producer.storage-current","v":{"rule":"the operator moved two currently unnecessary producers into storage","implication":"a lower visible producer count than the historical eight is not by itself evidence of producer-recognition failure","storage_learning":"defer learning storage mechanics for now","date":"2026-08-21"}}
{"e":"U","k":"energy.zero-recovery-learning","v":{"trigger":"when Merge Boss energy reaches 0","first_action":"tap the plus icon beside the game energy value","learning_goal":"inspect and learn every energy-recovery menu/action shown after opening the plus menu","common_flow":["tap recovery option","transition to reward/ad flow","wait the displayed countdown","when countdown becomes a check mark tap the check","return to Merge Boss"],"exceptions":"some recovery options may differ; observe each instead of assuming one universal flow","date":"2026-08-21"}}
{"e":"U","k":"special.green-cash-stack.max","v":{"rule":"a max-level green cash-stack item has no further merge progression; collect/convert it promptly to free board capacity","priority":"high","source":"human_teaching","date":"2026-08-21"}}
{"e":"U","k":"energy.search-task","v":{"rule":"for search-based free energy recovery, any ordinary search query is sufficient","completion":"once search results are shown, return immediately; no dwell time is required and that counts as one progress unit","source":"human_teaching","date":"2026-08-21"}}
{"e":"D","k":"family.tennis-goods.known_names.live-20260821","v":{"4":"スポーツ用ウォーターボトル","5":"ボールマシン","evidence":"live selected-item panel after verified merges","date":"2026-08-21"}}
{"e":"D","k":"family.cheering-spectator.known_names.live-20260821","v":{"2":"ファンマフラー","3":"三角フラッグ","4":"クラッパー","5":"笛","evidence":"live selected-item panels after verified merges","date":"2026-08-21"}}
{"e":"D","k":"family.fishing-supplies.known_names.live-20260821","v":{"1":"釣り糸のスプール","2":"複数の釣り糸スプール","3":"漁網","evidence":"live selected-item panels","date":"2026-08-21"}}
{"e":"D","k":"visual.fishing-supplies.lv1-vs-lv2","v":{"lv1":"single blue spool","lv2":"multiple/two blue spools","negative_evidence":"dragging visually similar Lv1 and Lv2 items did not merge and only exchanged positions","rule":"do not classify similar spool visuals as merge-compatible without level/identity agreement","date":"2026-08-21"}}
{"e":"U","k":"performance.speed-accuracy-policy","v":{"rule":"gameplay is speed-first; do not require one consequential action followed by one fresh observation as a universal rule","preferred_execution":"when confidence is high and actions are locally predictable/recoverable, use bounded predictive multi-action bursts and verify at useful checkpoints","mistakes":"gameplay mistakes are acceptable learning evidence; record recurring miss patterns and adapt future action selection to reduce them without turning play into per-action supervision","exceptions":"use tighter observe/action coupling for unknown screens, high-uncertainty transitions, irreversible/high-risk actions, bridge recovery, or when a prior prediction failed","source":"human_teaching","date":"2026-08-21"}}
{"e":"U","k":"performance.adaptive-observation","v":{"principle":"always consider multiple observation strategies and choose the best speed/accuracy tradeoff for the current state instead of applying one fixed method everywhere","default":"single fresh visual observation is preferred on stable predictable gameplay states","multi_frame":"when animation, transition, temporal ambiguity, or visual instability matters, compare two or more frames separated by a learned short interval rather than treating one instantaneous frame as authority","interval_learning":"learn per-transition/per-animation settle intervals from observed behavior; prefer the shortest interval that materially improves state recognition","cost_awareness":"do not run duplicate OCR/semantic observations by default because repeated analysis can dominate latency; prefer lightweight visual temporal sampling first and escalate only when needed","evaluation":"retain outcome evidence for competing methods so future policy can choose based on observed accuracy, latency, and failure rate","source":"human_teaching","date":"2026-08-21"}}
{"e":"D","k":"family.book.live-20260822","v":{"order_visual":{"level":6,"description":"green book with question-mark motif"},"next_merge":{"level":7,"display":"トレンド雑誌"},"evidence":"live order-item i panel","date":"2026-08-22"}}
{"e":"U","k":"architecture.candidate.unknown-order-learning","v":{"status":"candidate","observation":"merge_boss_turn currently aborts perception when an order-item visual is unknown, even though the item can be identified interactively from its i panel","candidate":"return a structured learn-required result that carries the unknown visual/evidence and supports an interactive learn-and-resume path, rather than treating this as an opaque terminal perception failure","evaluation":["resume latency","learning persistence","false identity risk","ability to continue bounded gameplay"],"do_not_promote_without_evidence":true,"date":"2026-08-22"}}
{"e":"U","k":"meta.rules-are-revisable","v":{"principle":"current gameplay rules, heuristics, thresholds, and architecture ideas are working hypotheses rather than absolute truth","during_play":"actively look for counterexamples, unnecessary conservatism, latency waste, and alternative strategies while playing","record":"when an alternative rule/design appears promising, preserve the current rule, the alternative, context, observed evidence, expected tradeoffs, and what would falsify either option","promotion":"replace or generalize a rule only after evidence shows the alternative is better for the relevant context; do not silently rewrite history","scope":"separate universal-looking core principles from Merge Boss-specific tactics and from temporary live-state facts","source":"human_teaching","date":"2026-08-22"}}
{"e":"U","k":"meta.strategy-comparison","v":{"principle":"for recurring decisions, maintain competing strategy candidates instead of treating the first successful method as final","compare_on":["latency","success_rate","error_cost","recovery_cost","observation_cost","robustness_to_animation","robustness_to_ui_change"],"play_loop":"use live play as an experiment surface when risk is low: choose a plausible method, observe outcomes at useful checkpoints, and update comparative evidence","examples":["single-frame vs temporal sampling","per-action verification vs bounded predictive bursts","full-screen analysis vs ROI analysis","visual-only vs OCR escalation","fixed delay vs learned settle interval"],"source":"human_teaching","date":"2026-08-22"}}
{"e":"U","k":"geometry.runtime-binding","v":{"principle":"absolute pixels are an execution-time binding, not durable action identity","priority":["semantic/accessibility element","recognized visual object/region","task-local geometry such as board row/column","reference/normalized calibration","final live-device pixel"],"current_merge_boss_binding":"calibration screen_size is a reference-device profile; board/order regions, hint slots, marker geometry, scroll actions and panel regions are scaled to the captured frame before recognition/action","aspect_ratio_note":"simple x/y frame scaling is the current minimum implementation, not assumed universally sufficient; preserve counterexamples from devices with materially different safe areas/aspect ratios and promote anchor-based alignment if evidence warrants it","source":"human_teaching+implementation","date":"2026-08-22"}}
{"e":"D","k":"merge.false-pair.empty-cells.20260822","v":{"observed":"the repeated visual pair r6c3/r6c6 remained after multiple drag attempts while item/free-cell state did not progress","root_cause":"strict visual candidate generation compared pale empty board cells and allowed their very high background similarity to become a merge candidate","fix":"exclude any candidate pair containing a cell below the board content threshold before strict/relaxed merge ranking","lesson":"board-change learning must distinguish item transitions, producer reclassification, random spawn, bubble spawn and empty-tile similarity rather than inferring merge success from pair similarity alone","date":"2026-08-22"}}
{"e":"D","k":"perception.empty-cell.producer-glow.20260822","v":{"observed":{"r6c3":{"inset_0.14":12.294,"inset_0.28":0.981},"r6c6":{"inset_0.14":27.864,"inset_0.28":1.04},"synthetic_solid_item":{"inset_0.27":11.298,"inset_0.28":4.779}},"cause":"animated producer glow from the row below contaminated the wider cell crop and made truly empty cells look occupied","fix":"separate visual-identity crop from occupancy crop; keep the wider descriptor crop but use a deeper 0.27 center inset for occupancy/free-cell and merge-candidate gating","why_0.27":"0.28 rejected a compact solid synthetic item at the existing content threshold; 0.27 retained it while still strongly suppressing the observed neighbor-glow case","tradeoff":"adds one lightweight grid-description pass but removes repeated false drag/action+reobserve cycles, so expected end-to-end latency is lower on animated dense boards","date":"2026-08-22"}}
{"e":"U","k":"merge.bubble-causal-detection","v":{"status":"candidate","teaching":"after a merge, the normal successor stays in the original/destination cell and an extra successor copy may appear in a nearby cell wrapped in a bubble","runtime_candidate":"if a just-executed merge fails to gain the expected free cell and the next visual merge pair contains the previous destination plus a different nearby cell, treat the different cell as a probable bubble and tap it before ordinary planning","ambiguity":"if the apparent duplicate is exactly the original source+destination pair, do not assume bubble from this evidence alone because the drag may have been a no-op","goal":"use causal transition evidence before relying on a global color/halo detector","source":"human_teaching+live_failure_analysis","date":"2026-08-22"}}
{"e":"D","k":"performance.trace-triage.20260822","v":{"session":"local-session-redacted","evidence":{"action_batch":{"count":50,"avg_ms":1225.3,"total_ms":61265.5},"merge_boss_board":{"count":44,"avg_ms":1200.9,"total_ms":52839.0},"observation_result":{"count":60,"avg_ms":430.2,"total_ms":25809.4},"workflow_decision":{"count":44,"avg_ms":1.6,"total_ms":71.4}},"interpretation":"board perception and phone action transport are the clear repeated latency costs; planner decision time is negligible","priority_candidates":["reduce redundant full-board analysis","increase safe bounded action batching","use lightweight urgent-object checks such as bubble detection","investigate action transport latency separately when convenient"],"date":"2026-08-22"}}
{"e":"U","k":"merge.random-green-cash-spawn","v":{"rule":"a successful merge can randomly create an additional green cash/banknote item in another board cell","capacity_effect":"when this extra item occupies the newly-freed capacity, free_cells may stay unchanged even though the merge succeeded","diagnostic":"free-cell delta alone must not be used to infer merge failure or bubble creation; compare before/after occupied cells and classify the new object","source":"human_teaching","date":"2026-08-22"}}
{"e":"U","k":"interaction.select-then-action","v":{"rule":"for board items whose item action is activated by tapping the selected object, the first tap selects and displays the top hint while the second tap performs the item action","application":"when bubble/collect/convert semantics require the item action, use two taps unless object-specific evidence says otherwise","reason":"a single tap may only change selection and therefore appear to do nothing","source":"human_teaching","date":"2026-08-22"}}
{"e":"U","k":"learning.async-human-questions","v":{"rule":"AI-originated questions remain durably answerable after the originating workflow continues or ends; low-risk play must not stop waiting for an answer","runtime":"poll late answers at safe boundaries while continuing useful work; when received, route reusable answers into Human Teaching/learning promotion","ui":"unanswered questions in conversation history remain replyable, not read-only history","source":"human_teaching","date":"2026-08-22"}}
{"e":"U","k":"performance.end-to-end-cadence","v":{"rule":"performance observation includes end-to-end action-to-action elapsed time and measurable outside-tool gaps in addition to capture/recognition/action internals","outside_tool_gap":"time from one host request completion to the next host request start; includes planner/model/orchestration/transport idle and is not private chain-of-thought","priority":"large obvious latency sources are eligible for immediate fix-play-measure loops; defer micro-optimization until dominant costs are known","source":"human_teaching","date":"2026-08-22"}}
{"e":"D","k":"merge.bubble-causal-detection.negative-20260822","v":{"observed":"automatic bubble candidate r6c4 was selected after a merge even though no genuinely new occupied cell was detected; two taps left the phone on the Merge Boss board instead of opening the expected reward/ad flow","lesson":"a recurring visual duplicate pair plus missing free-cell gain is insufficient bubble evidence when before/after occupancy shows no new cell","revision":"when a pre-merge occupied-cell snapshot exists, automatic bubble preemption requires the candidate to occupy a genuinely new cell; otherwise defer to anomaly/no-op learning instead of tapping it as a bubble","date":"2026-08-22"}}
{"e":"U","k":"merge.noop-suppression","v":{"status":"candidate","rule":"if both source and target retain the same learned identity/level after a drag, treat that pair as a strong no-op candidate and suppress the same pair for the rest of the current bounded burst","reason":"prevents repeated false-positive visual merge actions from consuming action/recognition time","scope":"burst-local until more live evidence supports longer-lived suppression","date":"2026-08-22"}}
{"e":"U","k":"human-teaching.active-question-policy","v":{"rule":"Human Teaching is both operator-initiated input and AI-initiated focused questions when a present human can cheaply resolve a material reusable ambiguity","ask_when":["repeated action/observation mismatch affects future policy","unknown semantics blocks or distorts planning","fresh evidence conflicts with learned knowledge","short human explanation can prevent repeated expensive inspection or repeated mistakes"],"do_not_ask_when":"confidence is already high and a miss is cheap/recoverable; continue autonomously instead","persistence":"learning-oriented operator answers are re-enqueued as pending Human Teaching so they must be compared with existing knowledge, durably persisted when appropriate, verified, and then handled","source":"human_teaching","date":"2026-08-22"}}
